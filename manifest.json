{
  "manifest_version": 3,
  "name": "Coles Rapid Slot Checker",
  "version": "0.3.0",
  "description": "Polls Coles checkout for Rapid delivery slots and notifies when one opens.",
  "browser_specific_settings": {
    "gecko": {
      "id": "coles-rapid-checker@local",
      "strict_min_version": "128.0",
      "update_url": "https://cmadds.github.io/coles-rapid-checker/updates.json"
    }
  },
  "permissions": ["alarms", "notifications", "storage"],
  "host_permissions": [
    "https://www.coles.com.au/*",
    "https://shop.coles.com.au/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://www.coles.com.au/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Coles Rapid Checker"
  },
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  }
}
